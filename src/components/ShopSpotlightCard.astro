---
interface Props {
  title: string;
  author: string;
  image: string;
  href: string;
  metric?: string;
}

const { title, author, image, href, metric } = Astro.props;
const meta = metric ? `${author} • ${metric}` : author;
---

<a href={href} class="spot-card">
  <span class="spot-card__media">
    <img src={image} alt="" width="72" height="108" loading="lazy" />
  </span>
  <span class="spot-card__text">
    <span class="spot-card__title">{title}</span>
    <span class="spot-card__meta">{meta}</span>
  </span>
</a>

<style>
  .spot-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-card);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .spot-card:hover {
    border-color: color-mix(in srgb, var(--color-btc) 45%, var(--color-border));
    box-shadow: 0 6px 20px color-mix(in srgb, var(--ink) 8%, transparent);
    transform: translateY(-1px);
  }

  .spot-card__media {
    flex-shrink: 0;
    width: 3.25rem;
    border-radius: 0.4rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-page);
  }

  .spot-card__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .spot-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .spot-card__title {
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
  }

  .spot-card__meta {
    color: var(--color-secondary);
    font-size: 0.875rem;
    line-height: 1.3;
  }
</style>
