---
interface Props {
  title: string;
  author: string;
  image: string;
  href: string;
  metric?: string;
}

const { title, author, image, href, metric } = Astro.props;
const meta = metric ? `${author} · ${metric}` : author;
---

<a href={href} class="spot-card">
  <span class="spot-card__media">
    <img src={image} alt="" width="80" height="120" loading="lazy" />
  </span>
  <span class="spot-card__text">
    <span class="spot-card__title">{title}</span>
    <span class="spot-card__meta">{meta}</span>
  </span>
</a>

<style>
  .spot-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-card);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 4%, transparent);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .spot-card:hover {
    border-color: color-mix(in srgb, var(--btc) 40%, var(--color-border));
    box-shadow: 0 10px 28px color-mix(in srgb, var(--ink) 9%, transparent);
    transform: translateY(-2px);
  }

  .spot-card__media {
    flex-shrink: 0;
    width: 3.75rem;
    border-radius: 0.45rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-page) 80%, var(--color-card));
    box-shadow: 0 4px 12px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .spot-card__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .spot-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .spot-card__title {
    font-weight: 800;
    font-size: 0.98rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .spot-card:hover .spot-card__title {
    color: var(--color-link);
  }

  .spot-card__meta {
    color: var(--color-secondary);
    font-size: 0.82rem;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
