---
import site from "../data/site.json";
import { localePath, t, type Locale } from "../i18n/ui";
import { categoryLabel, categoryPath, getCategories } from "../lib/catalog";

interface Props {
  locale?: Locale;
}

const { locale = "sq" } = Astro.props;
const strings = t(locale);
const MAIN_SITE = site.mainSite;
const rssHref = locale === "en" ? "/en/rss.xml" : "/rss.xml";
const categories = getCategories();
---

<footer class="site-footer bg-surface pt-12">
  <div class="section-shell pb-10">
    <div class="site-footer__grid">
      <div>
        <h2 class="site-footer__heading">{strings.footerCatalogHeading}</h2>
        <nav class="site-footer__nav" aria-label={strings.footerCatalogHeading}>
          {
            categories.map((cat) => (
              <a href={categoryPath(cat.id, locale)}>{categoryLabel(cat.id, locale)}</a>
            ))
          }
          <a href={localePath("/brands/", locale)}>{strings.catalogExploreBrands}</a>
          <a href={localePath("/blog/", locale)}>{strings.blog}</a>
        </nav>
      </div>

      <div>
        <h2 class="site-footer__heading">{strings.footerSiteHeading}</h2>
        <nav class="site-footer__nav" aria-label={strings.footerSiteHeading}>
          <a href={localePath("/about/", locale)}>{strings.footerAbout}</a>
          <a href={localePath("/search/", locale)}>{strings.search}</a>
          <a href={rssHref}>RSS</a>
        </nav>
        <p class="site-footer__trust">{strings.catalogTrustLine}</p>
      </div>

      <div>
        <h2 class="site-footer__heading">{strings.footerCommunityHeading}</h2>
        <nav class="site-footer__nav" aria-label={strings.footerCommunityHeading}>
          <a href={MAIN_SITE} target="_blank" rel="noopener noreferrer">{strings.footerMainSite}</a>
          <a href="https://t.me/dua_crypto" target="_blank" rel="noopener noreferrer">Telegram</a>
          <a href={`${MAIN_SITE}/newsletter.html`} target="_blank" rel="noopener noreferrer">Newsletter</a>
        </nav>
      </div>
    </div>
  </div>

  <div class="site-footer__bar border-t border-border py-6">
    <div class="section-shell site-footer__bar-inner">
      <p>
        &copy; <a href={MAIN_SITE} class="text-link hover:underline">DuaCrypto {new Date().getFullYear()}</a>, {strings.footerAllRightsReserved}
      </p>
      <p class="site-footer__credit">
        {strings.catalogTbhCredit}{" "}
        <a href="https://thebitcoinhole.com/" class="text-link hover:underline" target="_blank" rel="noopener noreferrer"
          >The Bitcoin Hole</a
        >
        {" "}(MIT).
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .site-footer__heading {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .site-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-secondary);
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer__nav a:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .site-footer__nav a:hover {
    color: var(--color-link);
  }

  .site-footer__trust {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .site-footer__bar-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  @media (min-width: 768px) {
    .site-footer__bar-inner {
      flex-direction: row;
      text-align: left;
    }

    .site-footer__credit {
      text-align: right;
    }
  }
</style>
