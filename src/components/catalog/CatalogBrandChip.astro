---
import type { Locale } from "../../i18n/ui";
import { brandLogoNeedsWordmark, brandPath, type CatalogBrandSummary } from "../../lib/catalog";

interface Props {
  brand: CatalogBrandSummary;
  locale?: Locale;
  variant?: "marquee" | "grid" | "directory";
}

const { brand, locale = "sq", variant = "grid" } = Astro.props;
const chipClass =
  variant === "marquee" || variant === "directory"
    ? "catalog-brand-chip catalog-brand-chip--marquee"
    : "catalog-brand-chip";
const showWordmark = !brand.logo || brandLogoNeedsWordmark(brand.id);
const imgLoading = variant === "marquee" ? "eager" : "lazy";
---

<a href={brandPath(brand.id, locale)} class={chipClass} aria-label={brand.name}>
  {
    showWordmark ? (
      <span class="catalog-brand-chip__name" aria-hidden="true">{brand.name}</span>
    ) : (
      <img src={brand.logo!} alt="" width="48" height="48" loading={imgLoading} />
    )
  }
</a>
