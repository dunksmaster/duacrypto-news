---
import type { Locale } from "../../i18n/ui";
import { brandMonogram, brandPath, type CatalogBrandSummary } from "../../lib/catalog";

interface Props {
  brand: CatalogBrandSummary;
  locale?: Locale;
}

const { brand, locale = "sq" } = Astro.props;
const monogram = brandMonogram(brand.name);
---

<a href={brandPath(brand.id, locale)} class="catalog-brand-chip" aria-label={brand.name}>
  {
    brand.logo ? (
      <img src={brand.logo} alt="" width="48" height="48" loading="lazy" />
    ) : (
      <span class="catalog-brand-chip__monogram" aria-hidden="true">{monogram}</span>
    )
  }
</a>
