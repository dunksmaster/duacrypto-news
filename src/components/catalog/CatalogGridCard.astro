---
import type { CatalogItemSummary } from "../../lib/catalog";
import { itemPath } from "../../lib/catalog";
import type { Locale } from "../../i18n/ui";

interface Props {
  item: CatalogItemSummary;
  locale?: Locale;
}

const { item, locale = "sq" } = Astro.props;
const href = itemPath(item.category, item.id, locale);
---

<a href={href} class="catalog-grid-card">
  {
    item.thumb && (
      <span class="catalog-grid-card__media">
        <img src={item.thumb} alt="" width="120" height="180" loading="lazy" />
      </span>
    )
  }
  <span class="catalog-grid-card__body">
    <span class="catalog-grid-card__title">{item.name}</span>
    {item.author && <span class="catalog-grid-card__meta">{item.author}</span>}
    {item.shortDescription && <span class="catalog-grid-card__desc">{item.shortDescription}</span>}
  </span>
</a>

<style>
  .catalog-grid-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-card);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    height: 100%;
  }

  .catalog-grid-card:hover {
    border-color: color-mix(in srgb, var(--cyan) 35%, var(--color-border));
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 8%, transparent);
    transform: translateY(-2px);
  }

  .catalog-grid-card__media {
    display: block;
    margin: 0 auto;
    max-width: 8rem;
    border-radius: 0.4rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-page);
  }

  .catalog-grid-card__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .catalog-grid-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .catalog-grid-card__title {
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
  }

  .catalog-grid-card__meta {
    color: var(--color-secondary);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .catalog-grid-card__desc {
    color: var(--color-secondary);
    font-size: 0.88rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
