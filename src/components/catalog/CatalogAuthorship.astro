---
import type { Locale } from "../../i18n/ui";
import { t } from "../../i18n/ui";
import type { CatalogField } from "../../lib/catalog";

interface Props {
  authorship: Record<string, CatalogField>;
  locale?: Locale;
}

const { authorship, locale = "sq" } = Astro.props;
const strings = t(locale);

const fields = Object.entries(authorship)
  .map(([key, field]) => {
    if (!field || typeof field !== "object") return null;
    const value = field.value?.trim();
    if (!value || value === "-") return null;
    return { key, label: key.charAt(0).toUpperCase() + key.slice(1), value, url: field.url };
  })
  .filter((f): f is { key: string; label: string; value: string; url?: string } => Boolean(f));

const hasContent = fields.length > 0;
---

{
  hasContent && (
    <section class="catalog-authorship">
      <p class="catalog-authorship__eyebrow">{strings.catalogAuthorshipEyebrow}</p>
      <h2 class="catalog-authorship__title">{strings.catalogAuthorshipTitle}</h2>
      <dl class="catalog-authorship__list">
        {fields.map((field) => (
          <>
            <dt>{field.label}</dt>
            <dd>
              {field.url ? (
                <a href={field.url} target="_blank" rel="noopener noreferrer">
                  {field.value}
                </a>
              ) : (
                field.value
              )}
            </dd>
          </>
        ))}
      </dl>
    </section>
  )
}

<style>
  .catalog-authorship {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-card);
  }

  .catalog-authorship__eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--btc);
  }

  .catalog-authorship__title {
    margin: 0 0 1rem;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .catalog-authorship__list {
    display: grid;
    gap: 0.5rem 1rem;
    margin: 0;
    grid-template-columns: minmax(7rem, auto) 1fr;
  }

  .catalog-authorship__list dt {
    margin: 0;
    color: var(--color-secondary);
    font-size: 0.9rem;
  }

  .catalog-authorship__list dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .catalog-authorship__list a {
    color: var(--color-link);
    text-decoration: none;
  }

  .catalog-authorship__list a:hover {
    text-decoration: underline;
  }
</style>
