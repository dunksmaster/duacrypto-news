---
import type { Locale } from "../../i18n/ui";
import { t, localePath } from "../../i18n/ui";
import {
  brandPath,
  categoryBlurb,
  categoryLabel,
  categoryPath,
  getBrands,
  getCategories,
  getSpotlightItems,
  itemPath,
} from "../../lib/catalog";
import ShopCategoryCard from "../ShopCategoryCard.astro";
import ShopSpotlightCard from "../ShopSpotlightCard.astro";

interface Props {
  locale?: Locale;
}

const { locale = "sq" } = Astro.props;
const strings = t(locale);
const categories = getCategories();
const spotlight = getSpotlightItems();
const allBrands = getBrands();
const brands = allBrands.slice(0, 12);
const productCount = categories.reduce((n, c) => n + c.count, 0) + 1;
---

<section class="catalog-hero">
  <div class="section-shell catalog-hero__inner">
    <p class="catalog-hero__eyebrow">DuaCrypto · Self-Custody</p>
    <h1 class="catalog-hero__title">{strings.catalogHeroTitle}</h1>
    <p class="catalog-hero__lead">{strings.catalogHeroSubtitle}</p>
    <div class="catalog-hero__stats">
      <span class="catalog-hero__stat">
        <strong>{productCount}+</strong> products
      </span>
      <span class="catalog-hero__stat">
        <strong>{allBrands.length}</strong> brands
      </span>
      <span class="catalog-hero__stat">
        <strong>{categories.length}</strong> categories
      </span>
    </div>
  </div>
</section>

<section class="catalog-section">
  <div class="section-shell">
    <header class="catalog-section__head">
      <p class="catalog-section__eyebrow">{strings.shopExploreEyebrow}</p>
      <h2 class="catalog-section__title">{strings.shopExploreTitle}</h2>
      <p class="catalog-section__lead">{strings.shopExploreLead}</p>
    </header>
    <div class="catalog-grid--cats">
      {
        categories.map((cat) => (
          <ShopCategoryCard
            title={categoryLabel(cat.id, locale)}
            description={categoryBlurb(cat, locale)}
            href={categoryPath(cat.id, locale)}
            image={cat.sampleThumb}
            visual={cat.visual ?? undefined}
          />
        ))
      }
    </div>
  </div>
</section>

{
  spotlight.length > 0 && (
    <section class="catalog-section catalog-section--muted">
      <div class="section-shell">
        <header class="catalog-section__head">
          <p class="catalog-section__eyebrow">{strings.catalogSpotlight}</p>
          <h2 class="catalog-section__title">{strings.catalogSpotlight}</h2>
          <p class="catalog-section__lead">{strings.catalogSpotlightLead}</p>
        </header>
        <div class="catalog-grid--spotlight">
          {spotlight.map((item) => (
            <ShopSpotlightCard
              title={item.name}
              author={item.author}
              image={item.thumb ?? item.image ?? "/img/duacrypto-logo.png"}
              href={itemPath(item.category, item.id, locale)}
            />
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="catalog-section">
  <div class="section-shell">
    <header class="catalog-section__head">
      <p class="catalog-section__eyebrow">{strings.catalogExploreBrands}</p>
      <h2 class="catalog-section__title">{strings.catalogExploreBrands}</h2>
      <p class="catalog-section__lead">{strings.catalogExploreBrandsLead}</p>
    </header>
    <div class="catalog-grid--brands">
      {
        brands.map((brand) => (
          <a href={brandPath(brand.id, locale)} class="catalog-brand-chip" title={brand.name}>
            {
              brand.logo ? (
                <img src={brand.logo} alt="" width="48" height="48" loading="lazy" />
              ) : (
                <span class="catalog-brand-chip__fallback">{brand.name.slice(0, 3)}</span>
              )
            }
          </a>
        ))
      }
    </div>
    <a href={localePath("/brands/", locale)} class="catalog-section__cta">
      {strings.viewAll} brands →
    </a>
  </div>
</section>

<style is:global>
  @import "../../styles/catalog.css";
</style>
