---
import type { Locale } from "../../i18n/ui";
import { t, localePath } from "../../i18n/ui";
import {
  brandPath,
  categoryBlurb,
  categoryLabel,
  categoryPath,
  getBrands,
  getCategories,
  getFeaturedComparison,
  getPromoCards,
  getSpotlightColumns,
} from "../../lib/catalog";
import ShopCategoryCard from "../ShopCategoryCard.astro";
import CatalogBrandMarquee from "./CatalogBrandMarquee.astro";
import CatalogFeaturedComparison from "./CatalogFeaturedComparison.astro";
import CatalogPromoCards from "./CatalogPromoCards.astro";
import CatalogSpotlightColumns from "./CatalogSpotlightColumns.astro";

interface Props {
  locale?: Locale;
}

const { locale = "sq" } = Astro.props;
const strings = t(locale);
const categories = getCategories();
const allBrands = getBrands();
const productCount = categories.reduce((n, c) => n + c.count, 0) + 1;
const featuredComparison = getFeaturedComparison(locale);
const promoCards = getPromoCards(locale);
const spotlightColumns = getSpotlightColumns();
---

<section class="catalog-hero">
  <div class="section-shell catalog-hero__inner">
    <p class="catalog-hero__eyebrow">DuaCrypto · Self-Custody</p>
    <h1 class="catalog-hero__title">{strings.catalogHeroTitle}</h1>
    <p class="catalog-hero__lead">{strings.catalogHeroSubtitle}</p>

    <nav class="catalog-hero__pills" aria-label={strings.catalogCategoryPillsLabel}>
      {
        categories.map((cat) => (
          <a href={categoryPath(cat.id, locale)} class="catalog-hero__pill">
            {categoryLabel(cat.id, locale)}
          </a>
        ))
      }
    </nav>

    <div class="catalog-hero__stats">
      <span class="catalog-hero__stat">
        <strong>{productCount}+</strong> products
      </span>
      <span class="catalog-hero__stat">
        <strong>{allBrands.length}</strong> brands
      </span>
      <span class="catalog-hero__stat">
        <strong>{categories.length}</strong> categories
      </span>
    </div>
    <p class="catalog-hero__trust">{strings.catalogTrustLine}</p>
  </div>
</section>

{featuredComparison && <CatalogFeaturedComparison data={featuredComparison} />}

{promoCards && (
  <CatalogPromoCards hotDeals={promoCards.hotDeals} newReleases={promoCards.newReleases} locale={locale} />
)}

<section class="catalog-section">
  <div class="section-shell">
    <header class="catalog-section__head">
      <p class="catalog-section__eyebrow">{strings.shopExploreEyebrow}</p>
      <h2 class="catalog-section__title">{strings.shopExploreTitle}</h2>
      <p class="catalog-section__lead">{strings.shopExploreLead}</p>
    </header>
    <div class="catalog-grid--cats">
      {
        categories.map((cat) => (
          <ShopCategoryCard
            title={categoryLabel(cat.id, locale)}
            description={categoryBlurb(cat, locale)}
            href={categoryPath(cat.id, locale)}
            image={cat.sampleThumb}
            visual={cat.visual ?? undefined}
          />
        ))
      }
    </div>
  </div>
</section>

<CatalogSpotlightColumns columns={spotlightColumns} locale={locale} />

<section class="catalog-section">
  <div class="section-shell">
    <header class="catalog-section__head">
      <p class="catalog-section__eyebrow">{strings.catalogExploreBrands}</p>
      <h2 class="catalog-section__title">{strings.catalogExploreBrands}</h2>
      <p class="catalog-section__lead">{strings.catalogExploreBrandsLead}</p>
    </header>
    <CatalogBrandMarquee brands={allBrands} locale={locale} />
    <a href={localePath("/brands/", locale)} class="catalog-section__cta">
      {strings.viewAll} brands →
    </a>
  </div>
</section>

<style is:global>
  @import "../../styles/catalog.css";
</style>
