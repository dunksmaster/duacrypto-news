---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string | null;
  visual?: string | null;
}

const { title, description, href, image, visual } = Astro.props;
---

<a href={href} class="cat-card">
  <div class:list={["cat-card__strip", visual && `cat-card__strip--${visual}`]}>
    {
      image ? (
        <img src={image} alt="" width="640" height="360" loading="lazy" />
      ) : (
        <div class="cat-card__motif" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
      )
    }
  </div>
  <div class="cat-card__body">
    <h3 class="cat-card__title">{title}</h3>
    <p class="cat-card__desc">{description}</p>
    <span class="cat-card__arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .cat-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-card);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 4%, transparent);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .cat-card:hover {
    border-color: color-mix(in srgb, var(--btc) 35%, var(--color-border));
    box-shadow: 0 12px 32px color-mix(in srgb, var(--ink) 10%, transparent);
    transform: translateY(-3px);
  }

  .cat-card__strip {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10.5rem;
    padding: 1.25rem;
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--color-page) 60%, #e8eef5) 0%,
      color-mix(in srgb, var(--color-page) 90%, #fff) 100%
    );
    overflow: hidden;
  }

  :root.dark .cat-card__strip,
  :root[data-theme="dark"] .cat-card__strip {
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--surface) 80%, #1a2332) 0%,
      color-mix(in srgb, var(--surface) 95%, #0d1220) 100%
    );
  }

  .cat-card__strip img {
    display: block;
    width: auto;
    max-width: min(70%, 9rem);
    max-height: 8.5rem;
    height: auto;
    object-fit: contain;
    border-radius: 0.5rem;
    padding: 0.5rem;
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--ink) 20%, transparent);
    transition: transform 0.25s ease;
  }

  .cat-card:hover .cat-card__strip img {
    transform: scale(1.04);
  }

  .cat-card__strip--mining {
    background:
      radial-gradient(circle at 25% 35%, color-mix(in srgb, var(--btc) 25%, transparent), transparent 50%),
      linear-gradient(165deg, #1a1f2e 0%, #0f131c 100%);
  }

  .cat-card__motif {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    height: 4rem;
  }

  .cat-card__motif span {
    display: block;
    width: 1.75rem;
    border-radius: 0.3rem 0.3rem 0 0;
    background: linear-gradient(180deg, var(--btc), color-mix(in srgb, var(--btc) 50%, var(--ink)));
  }

  .cat-card__motif span:nth-child(1) {
    height: 55%;
  }
  .cat-card__motif span:nth-child(2) {
    height: 100%;
  }
  .cat-card__motif span:nth-child(3) {
    height: 72%;
  }

  .cat-card__body {
    position: relative;
    padding: 1.15rem 1.25rem 1.3rem;
    border-top: 1px solid var(--color-border);
  }

  .cat-card__title {
    margin: 0 0 0.4rem;
    padding-right: 1.5rem;
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .cat-card:hover .cat-card__title {
    color: var(--color-link);
  }

  .cat-card__desc {
    margin: 0;
    color: var(--color-secondary);
    font-size: 0.88rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cat-card__arrow {
    position: absolute;
    top: 1.15rem;
    right: 1.15rem;
    color: var(--btc);
    font-size: 1.1rem;
    font-weight: 700;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .cat-card:hover .cat-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
