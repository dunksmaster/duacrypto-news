---
import site from "../data/site.json";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { t, localePath, type Locale } from "../i18n/ui";
import { categoryLabel, categoryPath, getCategories } from "../lib/catalog";

interface Props {
  locale?: Locale;
  switchTarget?: { href: string; available: boolean; label?: string };
}

const { locale = "sq", switchTarget } = Astro.props;
const strings = t(locale);
const { pathname } = Astro.url;
const MAIN_SITE = site.mainSite;
const prefix = locale === "en" ? "/en" : "";
const categories = getCategories();

const isCatalogPath = categories.some(
  (c) => pathname.includes(`/${c.id}`) || pathname.includes(`/en/${c.id}`),
);

const nav = [
  { href: localePath("/", locale), label: strings.home, match: pathname === prefix || pathname === `${prefix}/` },
  { href: localePath("/blog/", locale), label: strings.blog, match: pathname.includes("/blog") },
  { href: localePath("/about/", locale), label: strings.about, match: pathname.includes("/about") },
];
---

<header class="site-header sticky top-0 z-50 border-b border-border">
  <div class="section-shell site-header__shell">
    <div class="site-header__bar">
      <a href={localePath("/", locale)} class="site-header__brand" aria-label="DuaCrypto home">
        <img
          src="/img/duacrypto-logo.png"
          alt="DuaCrypto"
          width="379"
          height="378"
          class="h-10 w-auto"
        />
        <span class="site-header__wordmark hidden sm:inline">Self-Custody<br />Catalog</span>
      </a>

      <button
        id="nav-toggle"
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        title="Toggle navigation"
      >
        <span class="text-xl" aria-hidden="true">☰</span>
      </button>
    </div>

    <nav id="nav-menu" class="site-header__nav">
      <div class="site-header__nav-links">
        {nav.map((item) => (
          <a href={item.href} class:list={["nav-link", { "nav-link-active": item.match }]}>
            {item.label}
          </a>
        ))}

        <div class="nav-dropdown">
          <button
            type="button"
            class:list={["nav-link nav-dropdown__toggle", { "nav-link-active": isCatalogPath }]}
            aria-expanded="false"
            aria-haspopup="true"
            id="cat-menu-toggle"
          >
            {strings.allCategories} ▾
          </button>
          <div class="nav-dropdown__menu" id="cat-menu" hidden>
            {
              categories.map((cat) => (
                <a href={categoryPath(cat.id, locale)} class="nav-dropdown__item">
                  {categoryLabel(cat.id, locale)}
                </a>
              ))
            }
            <a href={localePath("/brands/", locale)} class="nav-dropdown__item">
              {strings.catalogExploreBrands}
            </a>
          </div>
        </div>

        <a href={localePath("/search/", locale)} class="nav-link">{strings.search}</a>
        <a href={MAIN_SITE} class="nav-link">{strings.mainSite}</a>
      </div>

      <div class="site-header__nav-actions">
        <LanguageSwitcher locale={locale} switchTarget={switchTarget} />
        <button
          type="button"
          data-theme-toggle
          class="theme-toggle"
          aria-pressed="false"
          aria-label="Switch theme"
        >
          <span data-theme-icon>◐</span>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  function setMenuOpen(open: boolean) {
    const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
    if (isDesktop) return;

    menu?.classList.toggle("is-open", open);
    menu?.setAttribute("aria-hidden", String(!open));
    toggle?.setAttribute("aria-expanded", String(open));
  }

  function syncNavState() {
    const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
    if (isDesktop) {
      menu?.classList.remove("is-open");
      menu?.setAttribute("aria-hidden", "false");
      toggle?.setAttribute("aria-expanded", "false");
      return;
    }

    const open = menu?.classList.contains("is-open") ?? false;
    menu?.setAttribute("aria-hidden", String(!open));
    toggle?.setAttribute("aria-expanded", String(open));
  }

  syncNavState();

  toggle?.addEventListener("click", () => {
    const open = !menu?.classList.contains("is-open");
    setMenuOpen(open);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false));
  });

  window.matchMedia("(min-width: 1024px)").addEventListener("change", () => {
    syncNavState();
  });

  const catToggle = document.getElementById("cat-menu-toggle");
  const catMenu = document.getElementById("cat-menu");
  catToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const open = catMenu?.hasAttribute("hidden");
    if (open) {
      catMenu?.removeAttribute("hidden");
      catToggle?.setAttribute("aria-expanded", "true");
    } else {
      catMenu?.setAttribute("hidden", "");
      catToggle?.setAttribute("aria-expanded", "false");
    }
  });

  document.addEventListener("click", (e) => {
    if (!catToggle || !catMenu) return;
    const target = e.target as Node;
    if (!catToggle.contains(target) && !catMenu.contains(target)) {
      catMenu.setAttribute("hidden", "");
      catToggle.setAttribute("aria-expanded", "false");
    }
  });

  const themeBtn = document.querySelector("[data-theme-toggle]");
  const icon = document.querySelector("[data-theme-icon]");
  const root = document.documentElement;

  function applyTheme(theme: "light" | "dark") {
    const isDark = theme === "dark";
    root.classList.toggle("dark", isDark);
    root.setAttribute("data-theme", theme);
    root.style.colorScheme = theme;
    themeBtn?.setAttribute("aria-pressed", String(isDark));
    themeBtn?.setAttribute(
      "aria-label",
      isDark ? "Switch to light mode" : "Switch to dark mode",
    );
    if (icon) icon.textContent = isDark ? "☀" : "◐";
    localStorage.setItem("duacrypto-theme", theme);
  }

  const stored = localStorage.getItem("duacrypto-theme");
  const initial =
    stored === "dark" || stored === "light"
      ? stored
      : window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
  applyTheme(initial);

  themeBtn?.addEventListener("click", () => {
    const next = root.classList.contains("dark") ? "light" : "dark";
    applyTheme(next);
  });
</script>

<style>
  .site-header {
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .site-header__shell {
    position: relative;
  }

  .site-header__bar {
    display: flex;
    height: 68px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .site-header__wordmark {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-left: 1px solid var(--color-border);
    padding-left: 10px;
    line-height: 1.3;
  }

  .site-header__toggle {
    display: inline-flex;
    min-height: 2.75rem;
    min-width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.375rem;
    padding: 0.5rem;
    color: var(--color-dark);
    background: transparent;
    cursor: pointer;
  }

  .site-header__nav {
    display: none;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    padding: 0.75rem 0 1rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .site-header__nav.is-open {
    display: flex;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;
    box-shadow: 0 12px 24px color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .site-header .nav-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    white-space: nowrap;
    background: none;
    border: none;
    cursor: pointer;
    color: inherit;
    padding: 0;
  }

  .site-header__nav-links {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
  }

  .site-header__nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  @media (min-width: 1024px) {
    .site-header__shell {
      display: flex;
      height: 68px;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .site-header__bar {
      height: auto;
      flex-shrink: 0;
    }

    .site-header__toggle {
      display: none;
    }

    .site-header__nav,
    .site-header__nav.is-open {
      display: flex;
      position: static;
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: 1.5rem;
      border-top: 0;
      background: transparent;
      padding: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .site-header__nav-links {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
      margin-left: auto;
    }

    .site-header__nav-actions {
      margin-left: 1.5rem;
      padding-top: 0;
    }

    .site-header .nav-link {
      padding-block: 1.5rem;
    }
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 60;
    min-width: 14rem;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    background: var(--color-surface);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .nav-dropdown__menu[hidden] {
    display: none;
  }

  @media (max-width: 1023px) {
    .nav-dropdown__menu {
      position: static;
      box-shadow: none;
      margin-top: 0.25rem;
      margin-left: 0.5rem;
    }
  }

  .nav-dropdown__item {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: 0.4rem;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav-dropdown__item:hover {
    background: color-mix(in srgb, var(--cyan) 10%, var(--color-page));
    color: var(--color-link);
  }
</style>
