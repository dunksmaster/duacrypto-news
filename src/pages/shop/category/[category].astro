---
export function getStaticPaths() {
  return [{ params: { category: "books" } }, { params: { category: "mining" } }];
}

const targets: Record<string, string> = {
  books: "/books/",
  mining: "/mining/",
};

const { category } = Astro.params;
return Astro.redirect(targets[category!] ?? "/", 301);
---
