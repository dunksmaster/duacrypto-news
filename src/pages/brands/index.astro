---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogBrandChip from "../../components/catalog/CatalogBrandChip.astro";
import { brandLogoNeedsWordmark, brandPath, getBrandItems, getBrands } from "../../lib/catalog";
import { t, localePath } from "../../i18n/ui";

const locale = "sq" as const;
const strings = t(locale);
const brands = getBrands();
---

<BaseLayout
  title={strings.catalogExploreBrands}
  description={strings.catalogExploreBrandsLead}
  lang="sq"
  locale={locale}
  canonical={`${Astro.site}brands/`}
  switchTarget={{
    href: localePath("/brands/", "en"),
    available: true,
    label: strings.readInEnglish,
  }}
>
  <section class="brands-page" data-pagefind-body>
    <div class="section-shell">
      <nav class="brands-page__crumbs meta-mono" aria-label="Breadcrumb">
        <a href={localePath("/", locale)}>{strings.home}</a>
        <span aria-hidden="true">/</span>
        <span>{strings.catalogExploreBrands}</span>
      </nav>

      <header class="brands-page__head">
        <h1>{strings.catalogExploreBrands}</h1>
        <p>{strings.catalogExploreBrandsLead}</p>
        <p class="brands-page__stats">
          {brands.length} {strings.catalogBrandsLabel.toUpperCase()}
        </p>
      </header>

      <div class="brands-page__grid">
        {
          brands.map((brand) => {
            const count = getBrandItems(brand.id).length;
            const href = brandPath(brand.id, locale);
            return (
              <article class="brand-tile">
                <CatalogBrandChip brand={brand} locale={locale} variant="directory" />
                {brand.logo && !brandLogoNeedsWordmark(brand.id) && <p class="brand-tile__name">{brand.name}</p>}
                {
                  (brand.headquarters || count > 0) && (
                    <p class="brand-tile__meta">
                      {brand.headquarters && brand.headquarters !== "-" ? brand.headquarters : null}
                      {brand.headquarters && brand.headquarters !== "-" && count > 0 ? " · " : null}
                      {count > 0 ? `${count} ${strings.catalogProductsLabel}` : null}
                    </p>
                  )
                }
                <a href={href} class="brand-tile__link">{strings.catalogViewBrand}</a>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
