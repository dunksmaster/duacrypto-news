---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { brandPath, getBrandItems, getBrands } from "../../lib/catalog";
import { t, localePath } from "../../i18n/ui";

const locale = "sq" as const;
const strings = t(locale);
const brands = getBrands();
---

<BaseLayout
  title={strings.catalogExploreBrands}
  description={strings.catalogExploreBrandsLead}
  lang="sq"
  locale={locale}
  canonical={`${Astro.site}brands/`}
  switchTarget={{
    href: localePath("/brands/", "en"),
    available: true,
    label: strings.readInEnglish,
  }}
>
  <section class="brands-page" data-pagefind-body>
    <div class="section-shell">
      <nav class="brands-page__crumbs meta-mono" aria-label="Breadcrumb">
        <a href={localePath("/", locale)}>{strings.home}</a>
        <span aria-hidden="true">/</span>
        <span>{strings.catalogExploreBrands}</span>
      </nav>

      <header class="brands-page__head">
        <h1>{strings.catalogExploreBrands}</h1>
        <p>{strings.catalogExploreBrandsLead}</p>
      </header>

      <div class="brands-page__grid">
        {
          brands.map((brand) => {
            const count = getBrandItems(brand.id).length;
            return (
              <a href={brandPath(brand.id, locale)} class="brand-card">
                {
                  brand.logo ? (
                    <img src={brand.logo} alt="" width="64" height="64" loading="lazy" />
                  ) : (
                    <span class="brand-card__placeholder">{brand.name.slice(0, 2)}</span>
                  )
                }
                <span class="brand-card__name">{brand.name}</span>
                {brand.headquarters && <span class="brand-card__hq">{brand.headquarters}</span>}
                {count > 0 && <span class="brand-card__count">{count} products</span>}
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .brands-page {
    padding: 2.5rem 0 4rem;
  }

  .brands-page__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-secondary);
    font-size: 0.72rem;
  }

  .brands-page__crumbs a {
    color: var(--color-link);
    text-decoration: none;
  }

  .brands-page__head h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 3vw, 2.35rem);
  }

  .brands-page__head p {
    margin: 0 0 1.75rem;
    max-width: 40rem;
    color: var(--color-secondary);
    line-height: 1.55;
  }

  .brands-page__grid {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }

  .brand-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    background: var(--color-card);
    text-decoration: none;
    text-align: center;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .brand-card:hover {
    border-color: color-mix(in srgb, var(--cyan) 35%, var(--color-border));
    transform: translateY(-2px);
  }

  .brand-card img {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
  }

  .brand-card__placeholder {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cyan) 15%, var(--color-page));
    font-weight: 700;
    color: var(--color-secondary);
  }

  .brand-card__name {
    font-weight: 700;
    color: var(--color-text);
  }

  .brand-card__hq,
  .brand-card__count {
    font-size: 0.82rem;
    color: var(--color-secondary);
  }
</style>
