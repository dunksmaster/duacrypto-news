---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchPanel from "../components/SearchPanel.astro";
import { t } from "../i18n/ui";

const locale = "sq" as const;
const strings = t(locale);
---

<BaseLayout title={strings.searchTitle} description={strings.searchDescription} lang="sq" locale={locale}>
  <section class="py-12" data-pagefind-body>
    <div class="section-shell max-w-3xl">
      <h1 class="mb-6 text-4xl font-bold">{strings.searchTitle}</h1>
      <SearchPanel locale={locale} />
    </div>
  </section>
</BaseLayout>
