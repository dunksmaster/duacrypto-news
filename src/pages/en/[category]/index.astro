---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CatalogGridCard from "../../../components/catalog/CatalogGridCard.astro";
import {
  catalogCategoryPaths,
  categoryBlurb,
  categoryLabel,
  getCategory,
  getItems,
  isCatalogCategory,
} from "../../../lib/catalog";
import { t, localePath } from "../../../i18n/ui";
import site from "../../../data/site.json";

export function getStaticPaths() {
  return catalogCategoryPaths();
}

const locale = "en" as const;
const strings = t(locale);
const { category: categoryId } = Astro.params;

if (!categoryId || !isCatalogCategory(categoryId)) {
  return Astro.redirect("/en/");
}

const category = getCategory(categoryId)!;
const items = getItems(categoryId);
const label = categoryLabel(categoryId, locale);
const blurb = categoryBlurb(category, locale) || strings.shopExploreLead;
const isMining = categoryId === "mining";
---

<BaseLayout
  title={label}
  description={blurb}
  lang="en"
  locale={locale}
  canonical={`${Astro.site}en/${categoryId}/`}
  switchTarget={{
    href: localePath(`/${categoryId}/`, "sq"),
    available: true,
    label: strings.readInAlbanian,
  }}
>
  <section class="catalog-section" data-pagefind-body>
    <div class="section-shell">
      <nav class="cat-page__crumbs" aria-label="Breadcrumb">
        <a href={localePath("/", locale)}>{strings.home}</a>
        <span aria-hidden="true">/</span>
        <span>{label}</span>
      </nav>

      <header class="catalog-section__head">
        <p class="catalog-section__eyebrow">{strings.allCategories}</p>
        <h1 class="catalog-section__title">{isMining ? strings.catalogMiningTitle : label}</h1>
        <p class="catalog-section__lead">{isMining ? strings.catalogMiningLead : blurb}</p>
      </header>

      {
        isMining ? (
          <div class="cat-page__mining-cta">
            <p>{strings.shopBody}</p>
            <a href={site.telegramUrl} class="catalog-section__cta" target="_blank" rel="noopener noreferrer">
              {strings.shopCta}
            </a>
          </div>
        ) : (
          <div class="cat-page__grid">
            {items.map((item) => (
              <CatalogGridCard item={item} locale={locale} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .cat-page__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cat-page__crumbs a {
    color: var(--color-link);
    text-decoration: none;
  }

  .cat-page__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  .cat-page__mining-cta {
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-card);
    max-width: 36rem;
    box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .cat-page__mining-cta p {
    margin: 0 0 1.25rem;
    color: var(--color-secondary);
    line-height: 1.55;
  }
</style>
